#!/bin/sh
# PiFin Wi-Fi watchdog.
#
# The Pi 4's built-in Wi-Fi (brcmfmac) can get stuck with some routers: the link
# stays up and small packets pass, but the router's rate to the Pi collapses to
# 1 Mbit/s and anything larger stalls (endless "Loading…", freezes, a dead phone
# remote). It also gets stuck after a mesh router moves it to another access
# point (802.11v): "connected", an address from DHCP, but nothing passes, not
# even ARP. Reloading the driver fixes both. Every 30 s, while connected, this
# pings the router with small and with full-size packets. Stuck, twice in a row,
# means: big ones lost while small ones pass, or nothing answered and the
# router's MAC can't be resolved (a router that only blocks ping still answers
# ARP). Then it reloads the driver with comitup paused (so it doesn't detour
# through the setup hotspot). At most one reload every 5 minutes.
#
# It tests the link, not the Jellyfin server: a server that is asleep, slow or
# moved (a stale JELLYFIN_URL) must not reset the Wi-Fi every 5 minutes.

fails=0
last=0
while sleep 30; do
  # only judge the link while comitup says we are on a network
  [ "$(cat /run/pifin-wifi-state 2>/dev/null)" = CONNECTED ] || { fails=0; continue; }
  gw=$(ip route show default dev wlan0 2>/dev/null | awk '{print $3; exit}')
  [ -n "$gw" ] || { fails=0; continue; }
  if ping -q -c 2 -W 2 "$gw" >/dev/null 2>&1; then
    if ping -q -c 3 -W 2 -s 1400 -M dont "$gw" >/dev/null 2>&1; then
      fails=0
      continue
    fi
    why="small pings pass, full-size pings to the router fail"
  else
    # silent to ping: only a dead link if its MAC can't be resolved either
    ip neigh show "$gw" dev wlan0 | grep -qE 'FAILED|INCOMPLETE' || { fails=0; continue; }
    why="the router answers neither ping nor ARP"
  fi
  fails=$((fails + 1))
  echo "$why ($fails)"
  now=$(date +%s)
  if [ "$fails" -ge 2 ] && [ $((now - last)) -ge 300 ]; then
    echo "reloading the Wi-Fi driver"
    last=$now
    fails=0
    systemctl stop comitup
    modprobe -r brcmfmac_cyw brcmfmac_wcc brcmfmac 2>/dev/null
    sleep 2
    modprobe brcmfmac
    sleep 3
    systemctl start comitup
    /usr/sbin/iw dev wlan0 set power_save off 2>/dev/null || true
  fi
done
