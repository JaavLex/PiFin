IDLE_TIMEOUT = 30
PIN_ITER = 200000
PIN_MAX_FAILS = 5
PIN_LOCK_SECS = 60


def root():
    return os.environ.get("PIFIN_ROOT", "")


def P(path):
    return root() + path


def log(msg):
    print(f"pifin-settingsd: {msg}", file=sys.stderr, flush=True)


# ---- runner ---------------------------------------------------------------

def run(argv, timeout=10):
    """Run argv (never through a shell). Returns (rc, stdout)."""
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout
    except subprocess.TimeoutExpired:
        return 124, ""
    except FileNotFoundError:
        return 127, ""


RUN = run
NOW = time.monotonic
SLEEP = time.sleep


def spawn(fn):
    """Run fn in a daemon thread (after the reply). Tests replace SPAWN to join it."""
    t = threading.Thread(target=fn, daemon=True)
    t.start()
    return t


SPAWN = spawn
IDLE_POLL = 3600  # seconds; see main()


def tailscale_present():
    return os.path.exists(P(TAILSCALE))


TAILSCALE_PRESENT = tailscale_present


# ---- validation -----------------------------------------------------------

class Invalid(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code
        self.message = message


URL_RE = re.compile(r"^https?://[A-Za-z0-9.\-\[\]:]+(:\d{1,5})?(/[A-Za-z0-9._~\-/]*)?$")
CONTROL_RE = re.compile(r"[\x00-\x1f\x7f]")
PIN_RE = re.compile(r"^[0-9]{4,8}$")
NAME_RE = re.compile(r"^[a-z][a-z0-9-]{0,62}$")

URL_MSG = "The Jellyfin address must look like http://host:8096."
SSID_MSG = "A Wi-Fi name must be 1 to 32 bytes, without control characters."
PSK_MSG = ("The hotspot password must be 8 to 63 plain characters (letters, digits, symbols, "
           "spaces), without spaces at either end.")
PIN_MSG = "The PIN must be 4 to 8 digits."


def boolean(label):
    def check(v):
        if type(v) is not bool:
            raise Invalid("invalid_value", f"{label} must be true or false.")
    return check


def choice(values, message, numbers=(int,)):
    def check(v):
        if isinstance(v, bool) or not isinstance(v, numbers) or v not in values:
            raise Invalid("invalid_value", message)
    return check


def is_ssid(v):
    return (isinstance(v, str) and 1 <= len(v.encode("utf-8", "surrogatepass")) <= 32
            and not CONTROL_RE.search(v))


def check_ssid(v):
    if not is_ssid(v):
        raise Invalid("invalid_value", SSID_MSG)


def is_hotspot_ssid(v):
    # written unquoted as `ap_name: <v>`: comitup's configparser strips edge spaces
    return is_ssid(v) and v == v.strip() and v[0] not in "'\"#"


def check_hotspot_ssid(v):
    if not is_hotspot_ssid(v):
        raise Invalid("invalid_value", "The hotspot name must be 1 to 32 bytes, without "
                      "spaces at either end and not starting with a quote or #.")


def is_url(v):
    if not (isinstance(v, str) and URL_RE.match(v)):
        return False
    try:
        port = urllib.parse.urlsplit(v).port  # ValueError above 65535
    except ValueError:
        return False
    return port is None or port >= 1


def check_url_or_empty(v):
    # "" = migrated "not set"; `set` refuses it separately
    if not (v == "" or is_url(v)):
        raise Invalid("invalid_value", URL_MSG)


def is_psk(v):
    return isinstance(v, str) and 8 <= len(v) <= 63 and all(0x20 <= ord(c) <= 0x7E for c in v)


def is_hotspot_psk(v):
    # written unquoted as `ap_password: <v>`: comitup's configparser strips edge spaces
    return is_psk(v) and v == v.strip()


def check_psk(v):
    if not is_hotspot_psk(v):
        raise Invalid("invalid_value", PSK_MSG)


PLAYBACK = {
    "max_bitrate": choice({0, 40000000, 20000000, 10000000, 6000000, 3000000},
                          "Max bitrate must be one of: no limit, 40, 20, 10, 6 or 3 Mbit/s."),
    "max_height": choice({2160, 1080, 720, 480},
                         "Max resolution must be one of 2160, 1080, 720 or 480 lines."),
    "hdr": boolean("HDR"),
    "prefer_original": boolean("Prefer original"),
}
FIELDS = {
    "playback": PLAYBACK,
    "display": {
        "output_max_height": choice({2160, 1080, 720},
                                    "TV output resolution must be one of 2160, 1080 or 720 lines."),
        "subtitle_scale": choice({0.8, 1.0, 1.25, 1.5},
                                 "Subtitle size must be one of 0.8, 1.0, 1.25 or 1.5.",
                                 (int, float)),
        "audio_passthrough": boolean("Audio passthrough"),
    },
    "system": {
        "jellyfin_url": check_url_or_empty,
        "hotspot_ssid": check_hotspot_ssid,
        "pin_set": boolean("pin_set"),
    },
}
TOP_KEYS = {"version", "playback", "networks", "display", "system"}


def check_keys(d, want, where, exact=True):
    if not isinstance(d, dict):
        raise Invalid("bad_request", f"{where} must be an object.")
    for k in d:
        if k not in want:
            raise Invalid("bad_request", f"Unknown setting: {where}.{str(k)[:64]}.")
    if exact:
        for k in want:
            if k not in d:
                raise Invalid("bad_request", f"Missing setting: {where}.{k}.")


def validate(doc):
    """Raise Invalid unless doc is a complete, valid settings.json v1."""
    check_keys(doc, TOP_KEYS, "settings")
    if type(doc["version"]) is not int or doc["version"] != 1:
        raise Invalid("invalid_value", "Unsupported settings version.")
    for section, fields in FIELDS.items():
        check_keys(doc[section], fields, section)
        for k, check in fields.items():
            check(doc[section][k])
    nets = doc["networks"]
    if not isinstance(nets, dict):
        raise Invalid("bad_request", "networks must be an object.")
    for ssid, limits in nets.items():
        check_ssid(ssid)
        check_limits(limits)


def check_limits(limits):
    check_keys(limits, PLAYBACK, "networks", exact=False)
    if not limits:
        raise Invalid("invalid_value", "A network entry needs at least one limit.")
    for k, v in limits.items():
        PLAYBACK[k](v)


SETTABLE = {
