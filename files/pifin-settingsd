# ---- files ----------------------------------------------------------------

def chown(path, uid, gid):
    if root():  # tests run unprivileged
        return
    os.chown(path, -1 if uid is None else uid, -1 if gid is None else gid)


class Unsafe(Exception):
    """A file or directory the daemon refuses to touch (symlink, wrong owner, ...)."""


def open_dir(d, owner=None):
    """fd of directory d, its last component not a symlink; owner: required uid."""
    fd = os.open(d, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    if owner is not None and os.fstat(fd).st_uid != owner:
        os.close(fd)
        raise Unsafe(f"{d} is not owned by the PiFin user")
    return fd


def write_atomic(path, text, mode, uid=None, gid=None, owner=None):
    """tmp file in the same dir, fsync, chmod, chown, rename over the target.

    Everything goes through file descriptors (fchmod/fchown, renameat), never a path
    that could be swapped for a symlink: auth.json lives in a dir the pifin user can
    write. owner = uid the directory must belong to (user dirs), None = no check.
    """
    d, base = os.path.split(path)
    if owner is None:
        os.makedirs(d, exist_ok=True)
    dfd = open_dir(d, owner)
    try:
        for _ in range(10):
            tmp = f".{base}.{secrets.token_hex(6)}"
            try:
                fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                             0o600, dir_fd=dfd)
                break
            except FileExistsError:
                continue
        else:
            raise Unsafe(f"no free temp name in {d}")
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write(text)
                f.flush()
                os.fchmod(f.fileno(), mode)
                if (uid is not None or gid is not None) and not root():  # tests: unprivileged
                    os.fchown(f.fileno(), -1 if uid is None else uid, -1 if gid is None else gid)
                os.fsync(f.fileno())
            os.replace(tmp, base, src_dir_fd=dfd, dst_dir_fd=dfd)
        except BaseException:
            try:
                os.unlink(tmp, dir_fd=dfd)
            except OSError:
                pass
            raise
    finally:
        os.close(dfd)


def read_user_json(path, uid):
    """JSON from a file in a user-writable dir: no symlink (file or dir), a regular
    file owned by uid, at most 1 MiB. None if it does not exist. Raises Unsafe."""
    d, base = os.path.split(path)
    try:
        dfd = open_dir(d, uid)
    except FileNotFoundError:
        return None
    except OSError as e:  # ELOOP: the dir is a symlink
        raise Unsafe(f"{d} is not a plain directory") from e
    try:
        try:
            fd = os.open(base, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dfd)
        except FileNotFoundError:
            return None
        except OSError as e:
            raise Unsafe(f"{path} is not a plain file") from e
        with os.fdopen(fd, "rb") as f:
            st = os.fstat(f.fileno())
            if not stat.S_ISREG(st.st_mode) or st.st_uid != uid:
                raise Unsafe(f"{path} is not a plain file owned by the PiFin user")
            return json.loads(f.read(1 << 20))
    finally:
        os.close(dfd)


def read_text(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return None


def parse_env(path):
    """KEY=VALUE lines without a shell: the value is shlex's first token."""
    env = {}
    for line in (read_text(path) or "").splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        key, sep, value = line.partition("=")
        if not sep:
            continue
        try:
            tokens = shlex.split(value)
            value = tokens[0] if tokens else ""
        except ValueError:
            pass
        env[key.strip()] = value
    return env


def comitup_value(v):
    """comitup reads its file with a plain configparser.ConfigParser: no unquoting,
    BasicInterpolation. So values go in bare, with `%` doubled."""
    return v.replace("%", "%%")


def parse_comitup(path):
    """Read comitup.conf the way comitup does (configparser), so migration sees the
    password comitup really uses. An unreadable file reads as empty."""
    cp = configparser.ConfigParser()
    try:
        cp.read_string("[DEFAULT]\n" + (read_text(path) or ""))
        return dict(cp["DEFAULT"])
    except configparser.Error:
        return {}


def sh_quote(value):
    return "'" + value.replace("'", "'\\''") + "'"


def user_name():
    u = parse_env(P(SECRETS_ENV)).get("PIFIN_USER", "pifin")
    return u if NAME_RE.match(u) else "pifin"


def auth_path():
    return P(f"/home/{user_name()}/.config/pifin/auth.json")


def user_ids():
    """(uid, gid) of the pifin user and group; (None, None) in tests."""
    if root():
        return None, None
    u = user_name()
    return pwd.getpwnam(u).pw_uid, grp.getgrnam(u).gr_gid


def group_id():
    return user_ids()[1]


def user_uid():
    """uid that must own the files in the user's dirs (tests: whoever runs them)."""
    if root():
        return os.getuid()
    return pwd.getpwnam(user_name()).pw_uid


def load_auth():
    """auth.json as a dict, None if missing. Raises Unsafe (symlink, foreign owner,
    not a regular file): the pifin user controls that directory."""
    auth = read_user_json(auth_path(), user_uid())
    return auth if isinstance(auth, dict) else None


def dump(doc):
    return json.dumps(doc, indent=2, ensure_ascii=False) + "\n"


def load_json(path):
    with open(path, encoding="utf-8") as f:
        return json.load(f)


def load_settings():
    return load_json(P(SETTINGS))


def load_secrets():
    return load_json(P(SECRETS))


def write_settings(doc):
    write_atomic(P(SETTINGS), dump(doc), 0o644, 0, 0)


def write_secrets(doc):
    write_atomic(P(SECRETS), dump(doc), 0o600, 0, 0)


def secrets_ok(doc):
    return (isinstance(doc, dict) and set(doc) == {"pin_hash", "hotspot_pass"}
            and (doc["pin_hash"] is None
                 or (isinstance(doc["pin_hash"], str) and doc["pin_hash"].startswith("pbkdf2_sha256$")))
            and isinstance(doc["hotspot_pass"], str))


# ---- migration / start ----------------------------------------------------

def first(candidates, ok, default):
    for c in candidates:
        if c and ok(c):
            return c
    return default


def legacy_psk(env=None, com=None):
    env = parse_env(P(SECRETS_ENV)) if env is None else env
    com = parse_comitup(P(COMITUP_CONF)) if com is None else com
    return first([env.get("HOTSPOT_PASS"), com.get("ap_password")], is_hotspot_psk, "")


def migrate():
    """Build settings.json (and secrets.json if missing) from the legacy files."""
    app = parse_env(P(APP_CONF))
    env = parse_env(P(SECRETS_ENV))
    disp = parse_env(P(DISPLAY_CONF))
    com = parse_comitup(P(COMITUP_CONF))
    try:
        auth = load_auth()
        server = auth.get("server") if auth else None
    except Unsafe as e:
        log(f"auth.json ignored: {e}")
        server = None
    except (OSError, ValueError):
        server = None
    url = first([app.get("JELLYFIN_URL"), env.get("JELLYFIN_URL"), server], is_url, "")
    ssid = first([com.get("ap_name"), env.get("HOTSPOT_SSID")], is_hotspot_ssid, "PiFin-setup")
    psk = legacy_psk(env, com)
    try:
        height = int(disp.get("MAX_HEIGHT", ""))
    except ValueError:
        height = 1080
    if height not in (2160, 1080, 720):
        height = 1080

    sec = None
    try:
        sec = load_secrets()
        if not secrets_ok(sec):
            sec = None
    except (OSError, ValueError):
        pass
    if sec is None:
        sec = {"pin_hash": None, "hotspot_pass": psk}
        write_secrets(sec)
    doc = {
        "version": 1,
        "playback": {"max_bitrate": 0, "max_height": 1080, "hdr": False, "prefer_original": True},
        "networks": {},
        "display": {"output_max_height": height, "subtitle_scale": 1.0, "audio_passthrough": False},
        "system": {"jellyfin_url": url, "hotspot_ssid": ssid, "pin_set": sec["pin_hash"] is not None},
    }
    validate(doc)
    write_settings(doc)
    log("settings migrated from the legacy files")
    return doc


VERSION = ""


def init():
    """Load or migrate the store, make sure the pair token exists, cache the version."""
    global VERSION
    os.makedirs(P("/var/lib/pifin"), exist_ok=True)
    path = P(SETTINGS)
    doc = None
    if os.path.exists(path):
        try:
            doc = load_settings()
            validate(doc)
        except (OSError, ValueError, Invalid):
            bad = f"{path}.bad-{int(time.time())}"
            os.replace(path, bad)
            log(f"settings.json was invalid, kept as {os.path.basename(bad)}")
            doc = None
    if doc is None:
        doc = migrate()
    try:
        sec = load_secrets()
        if not secrets_ok(sec):
            raise ValueError("bad secrets.json")
    except (OSError, ValueError):
        if os.path.exists(P(SECRETS)):
            os.replace(P(SECRETS), f"{P(SECRETS)}.bad-{int(time.time())}")
            log("secrets.json was invalid, recreated (the PIN is cleared)")
        sec = {"pin_hash": None, "hotspot_pass": legacy_psk()}
        write_secrets(sec)
    pin_set = sec["pin_hash"] is not None
    if doc["system"]["pin_set"] != pin_set:
        doc["system"]["pin_set"] = pin_set
        write_settings(doc)
    if not os.path.exists(P(PAIR_TOKEN)):
        write_pair_token()
    rc, out = RUN([PIFIN_BIN, "--version"], timeout=5)
    out = out.strip()
    VERSION = out[len("pifin "):] if rc == 0 and out.startswith("pifin ") else ""


def write_pair_token():
    token = secrets.token_hex(16)
    write_atomic(P(PAIR_TOKEN), token, 0o640, 0, group_id())
    return token


# ---- PIN ------------------------------------------------------------------

FAILS = 0
LOCK_UNTIL = 0.0


def hash_pin(pin):
    salt = os.urandom(16)
    h = hashlib.pbkdf2_hmac("sha256", pin.encode(), salt, PIN_ITER)
    return f"pbkdf2_sha256${PIN_ITER}${salt.hex()}${h.hex()}"


def pin_matches(pin, stored):
    try:
        _, iters, salt, want = stored.split("$")
        h = hashlib.pbkdf2_hmac("sha256", pin.encode(), bytes.fromhex(salt), int(iters))
    except (ValueError, UnicodeEncodeError):
        return False
    return hmac.compare_digest(h.hex(), want)


def verify_pin(pin, stored):
    """Raise unless pin matches stored. Counts failures; 5 in a row lock for 60 s."""
    global FAILS, LOCK_UNTIL
    if NOW() < LOCK_UNTIL:
        raise Invalid("locked_out", "Too many wrong PINs. Try again in a minute.")
    if pin is None or pin == "":
        raise Invalid("pin_required", "Enter the PIN.")
    if not isinstance(pin, str) or not pin_matches(pin, stored):
        FAILS += 1
        if FAILS >= PIN_MAX_FAILS:
            FAILS = 0
            LOCK_UNTIL = NOW() + PIN_LOCK_SECS
            raise Invalid("locked_out", "Too many wrong PINs. Try again in a minute.")
        raise Invalid("pin_wrong", "Wrong PIN.")
    FAILS = 0


def pin_gate(pin):
    """Sensitive ops: free when no PIN is set, else the PIN must verify."""
    stored = load_secrets()["pin_hash"]
    if stored:
        verify_pin(pin, stored)


def store_pin(pin_hash):
    sec = load_secrets()
    sec["pin_hash"] = pin_hash
    write_secrets(sec)
    doc = load_settings()
    doc["system"]["pin_set"] = pin_hash is not None
    write_settings(doc)


# ---- side effects ---------------------------------------------------------

def set_env_lines(path, values, mode):
    """Replace or append KEY=<sh_quote> lines, keep every other line."""
    lines = (read_text(path) or "").splitlines()
    done = set()
    out = []
    for line in lines:
        key = line.partition("=")[0].strip()
        if key in values:
            if key in done:
                continue
            out.append(f"{key}={sh_quote(values[key])}")
            done.add(key)
        else:
            out.append(line)
    out += [f"{k}={sh_quote(v)}" for k, v in values.items() if k not in done]
    write_atomic(path, "\n".join(out) + "\n", mode, 0, 0)


def set_comitup_lines(path, values):
    """Edit comitup.conf in place: only the given `key: value` lines change."""
    lines = (read_text(path) or "").splitlines()
    done = set()
    out = []
    for line in lines:
        key = line.partition(":")[0].strip()
        if ":" in line and key in values:
            if key in done:
                continue
            out.append(f"{key}: {values[key]}")
            done.add(key)
        else:
            out.append(line)
    out += [f"{k}: {v}" for k, v in values.items() if k not in done]
    # In place, not tmp + rename: the unit makes /etc read-only except this one file
    # (ReadWritePaths=/etc/comitup.conf), so no temp file can be created next to it.
    data = ("\n".join(out) + "\n").encode()
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        view = memoryview(data)
        while view:
            view = view[os.write(fd, view):]
        os.ftruncate(fd, len(data))
        os.fsync(fd)
    finally:
        os.close(fd)


def preflight_auth():
    """Read auth.json before anything is written. None = nothing to update (no
    sign-in yet, or unreadable JSON). Unsafe file -> `failed`, nothing changes."""
    try:
        return load_auth()
    except Unsafe as e:
        log(f"refused to touch auth.json: {e}")
        raise Invalid("failed", "The sign-in file is not a plain file owned by the PiFin "
                      "user; nothing was changed.") from e
    except (OSError, ValueError):
        log("auth.json unreadable, server address not updated there")
        return None


def sync_jellyfin_url(url, auth):
    write_atomic(P(APP_CONF), f"JELLYFIN_URL={url}\n", 0o644, 0, 0)
    if auth is not None:
        auth["server"] = url
        uid, gid = user_ids()
        write_atomic(auth_path(), json.dumps(auth, indent=2) + "\n", 0o600, uid, gid,
                     owner=user_uid())
    RUN(["systemctl", "restart", "pifin-firewall"])


def sync_hotspot(psk=None, ssid=None):
    env, com = {}, {}
    if psk is not None:
        env["HOTSPOT_PASS"] = psk
        com["ap_password"] = comitup_value(psk)
    if ssid is not None:
        env["HOTSPOT_SSID"] = ssid
        com["ap_name"] = comitup_value(ssid)
    set_env_lines(P(SECRETS_ENV), env, 0o600)
    set_comitup_lines(P(COMITUP_CONF), com)
    _, out = RUN(["busctl", "call", "--system", "com.github.davesteele.comitup",
                  "/com/github/davesteele/comitup", "com.github.davesteele.comitup", "state"])
    if out.startswith('ss "HOTSPOT"'):
        RUN(["systemctl", "restart", "comitup"])


# ---- ops ------------------------------------------------------------------

def text_or(v, default):
    return v if isinstance(v, str) and v else default


def wifi_json():
    try:
        wifi = load_json(P(WIFI_JSON))
    except (OSError, ValueError):
        return {}
    return wifi if isinstance(wifi, dict) else {}


IFACE_RE = re.compile(r"^[A-Za-z0-9_.-]{1,15}$")
MAC_RE = re.compile(r"^[0-9a-f]{2}(:[0-9a-f]{2}){5}$")
UUID_RE = re.compile(r"^[0-9A-Fa-f-]{36}$")


def nm_split(line):
    """Fields of one `nmcli -t` line: `:` separates, `\\:` and `\\\\` are escapes."""
    fields, cur, i = [], [], 0
    while i < len(line):
        c = line[i]
        if c == "\\" and i + 1 < len(line):
            cur.append(line[i + 1])
            i += 2
            continue
        if c == ":":
            fields.append("".join(cur))
            cur = []
        else:
            cur.append(c)
        i += 1
    fields.append("".join(cur))
    return fields


def nm_unescape(value):
    return re.sub(r"\\(.)", r"\1", value)


def wifi_iface():
    """First connected Wi-Fi device, or None."""
    _, out = RUN(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE", "dev"])
    for line in out.splitlines():
        f = nm_split(line)
        if len(f) == 3 and f[1] == "wifi" and f[2] == "connected" and IFACE_RE.match(f[0]):
            return f[0]
    return None


def bus_of(netdir):
    """'usb' or 'builtin' for a /sys/class/net/<iface> dir, None if it has no device."""
    dev = os.path.join(netdir, "device")
    if not os.path.exists(dev):
        return None
    return "usb" if "/usb" in os.path.realpath(dev) else "builtin"


def signal_dbm(iface):
    for line in (read_text(P("/proc/net/wireless")) or "").splitlines():
        cols = line.split()
        # face | status | link | level | noise ...: the level column is the dBm value
        if len(cols) > 3 and cols[0] == iface + ":":
            try:
                return int(float(cols[3].rstrip(".")))
            except ValueError:
                return None
    return None


def iface_ip(iface):
    _, out = RUN(["nmcli", "-g", "IP4.ADDRESS", "dev", "show", iface])
    line = out.splitlines()[0] if out.strip() else ""
    ip = line.split("|")[0].strip().split("/")[0]
    return ip or None


def wifi_macs():
    macs = {"builtin": None, "usb": None}
    base = P("/sys/class/net")
    try:
        names = sorted(os.listdir(base))
    except OSError:
        return macs
    for name in names:
        d = os.path.join(base, name)
        if not os.path.isdir(os.path.join(d, "wireless")):
            continue
        bus = bus_of(d)
        mac = (read_text(os.path.join(d, "address")) or "").strip().lower()
        if bus and MAC_RE.match(mac) and macs[bus] is None:
            macs[bus] = mac
    return macs


TS_STATES = {"Running": "connected", "NeedsLogin": "signed_out", "Stopped": "off"}


def tailscale_status():
    st = {"state": "not_installed", "name": None, "ip": None}
    if not TAILSCALE_PRESENT():
        return st
    st["state"] = "unknown"
    _, out = RUN(["tailscale", "status", "--json"], timeout=5)
    try:
        doc = json.loads(out)
    except ValueError:
        return st
    if not isinstance(doc, dict):
        return st
    backend = doc.get("BackendState")
    if isinstance(backend, str) and backend:
        st["state"] = TS_STATES.get(backend, backend.lower())
    me = doc.get("Self") if isinstance(doc.get("Self"), dict) else {}
    st["name"] = text_or(me.get("HostName"), None)
    ips = me.get("TailscaleIPs") if isinstance(me.get("TailscaleIPs"), list) else []
    st["ip"] = next((ip for ip in ips if isinstance(ip, str) and "." in ip), None)
    return st


def status():
    """Every source is optional: a missing one gives null, never an error."""
    wifi = wifi_json()
    iface = wifi_iface()
    return {
        "wifi": {"state": text_or(wifi.get("state"), "unknown"), "ssid": text_or(wifi.get("ssid"), ""),
                 "radio": bus_of(P(f"/sys/class/net/{iface}")) if iface else None,
                 "iface": iface,
                 "signal_dbm": signal_dbm(iface) if iface else None,
                 "ip": iface_ip(iface) if iface else None},
        "macs": wifi_macs(),
        "tailscale": tailscale_status(),
        "version": VERSION,
    }


def op_get(req):
    return {"settings": load_settings(), "status": status()}


def op_set(req):
    changes = req.get("changes")
    if not isinstance(changes, dict) or not changes:
        raise Invalid("bad_request", "changes must be a non-empty object.")
    for k in changes:
        if k not in SETTABLE:
            raise Invalid("bad_request", f"Unknown setting: {str(k)[:64]}.")
    if SENSITIVE & changes.keys():
        pin_gate(req.get("pin"))
    doc = load_settings()
    sec = load_secrets()
    new, new_sec = copy.deepcopy(doc), dict(sec)
    for k, v in changes.items():
        if k == "secrets.hotspot_pass":
            check_psk(v)
            new_sec["hotspot_pass"] = v
        elif k == "system.jellyfin_url" and v == "":
            raise Invalid("invalid_value", URL_MSG)
        else:
            section, field = k.split(".")
            new[section][field] = v
    validate(new)
    auth = preflight_auth() if "system.jellyfin_url" in changes else None
    if new != doc:
        write_settings(new)
    if new_sec != sec:
        write_secrets(new_sec)
    if "system.jellyfin_url" in changes:
        sync_jellyfin_url(new["system"]["jellyfin_url"], auth)
    if "display.output_max_height" in changes:
        write_atomic(P(DISPLAY_CONF), f"MAX_HEIGHT={new['display']['output_max_height']}\n", 0o644, 0, 0)
    if "secrets.hotspot_pass" in changes or "system.hotspot_ssid" in changes:
        sync_hotspot(new_sec["hotspot_pass"] if "secrets.hotspot_pass" in changes else None,
                     new["system"]["hotspot_ssid"] if "system.hotspot_ssid" in changes else None)
    return {"settings": new}


def op_network_set(req):
    ssid, limits = req.get("ssid"), req.get("limits")
    check_ssid(ssid)
    doc = load_settings()
    new = copy.deepcopy(doc)
    if limits is None or limits == {}:
        new["networks"].pop(ssid, None)
    else:
        check_limits(limits)
        new["networks"][ssid] = limits
    validate(new)
    if new != doc:
        write_settings(new)
    return {"settings": new}


def check_pin_format(pin):
    if not isinstance(pin, str) or not PIN_RE.match(pin):
        raise Invalid("invalid_value", PIN_MSG)


def op_pin_set(req):
    pin = req.get("pin")
    check_pin_format(pin)
    stored = load_secrets()["pin_hash"]
    if stored:
        verify_pin(req.get("old_pin"), stored)
    store_pin(hash_pin(pin))
    return None


def op_pin_clear(req):
    stored = load_secrets()["pin_hash"]
    if stored:
        verify_pin(req.get("pin"), stored)
        store_pin(None)
    return None


def op_pin_check(req):
    pin_gate(req.get("pin"))
    return True


def op_pair_reset(req):
    return {"token": write_pair_token()}


# ---- network and system ops -----------------------------------------------

CLIENT_PSK_MSG = "A Wi-Fi password must be 8 to 63 plain characters (letters, digits, symbols, spaces)."
JOIN_FAILED = "Couldn't start joining the network."
AUTHKEY_RE = re.compile(r"^tskey-[A-Za-z0-9-]{10,200}$")


def wifi_profiles():
    """Saved Wi-Fi client profiles: [{"ssid", "uuid", "priority"}], hotspots left out."""
    rc, out = RUN(["nmcli", "-t", "-f", "NAME,UUID,TYPE,AUTOCONNECT-PRIORITY", "con", "show"])
    if rc != 0:
        raise Invalid("failed", "Couldn't read the saved networks.")
    profiles = []
    for line in out.splitlines():
        f = nm_split(line)
        if len(f) != 4 or f[2] != "802-11-wireless" or not UUID_RE.match(f[1]):
            continue
        rc, detail = RUN(["nmcli", "-g", "802-11-wireless.mode,802-11-wireless.ssid", "con", "show", f[1]])
        lines = detail.split("\n")
        if rc != 0 or len(lines) < 2:
            continue
        mode, ssid = nm_unescape(lines[0]), nm_unescape(lines[1])
        if mode in ("ap", "adhoc", "mesh") or not ssid:
            continue
        try:
            priority = int(f[3])
        except ValueError:
            priority = 0
        profiles.append({"ssid": ssid, "uuid": f[1], "priority": priority})
    return profiles


def op_wifi_list(req):
    return wifi_profiles()


def scan_entries():
    """(ssid, signal 0-100, secured) of nearby networks."""
    if wifi_json().get("state") == "HOTSPOT":
        # the radio is busy being the hotspot: ask comitup for its last scan
        rc, out = RUN(["busctl", "--json=short", "call", "--system", *COMITUP, "access_points"],
                      timeout=15)
        try:
            data = json.loads(out)["data"][0] if rc == 0 else None
        except (ValueError, KeyError, IndexError, TypeError):
            data = None
        if not isinstance(data, list):
            raise Invalid("failed", "Couldn't scan for networks.")
        for ap in data:
            if not isinstance(ap, dict):
                continue
            try:
                signal = int(float(ap.get("strength", "0")))
            except (TypeError, ValueError):
                signal = 0
            yield str(ap.get("ssid", "")), signal, ap.get("security") != "unencrypted"
        return
    cmd = ["nmcli", "-t", "-f", "SSID,SIGNAL,SECURITY", "dev", "wifi", "list", "--rescan"]
    rc, out = RUN(cmd + ["yes"], timeout=15)
    if rc != 0:
        rc, out = RUN(cmd + ["no"], timeout=15)
    if rc != 0:
        raise Invalid("failed", "Couldn't scan for networks.")
    for line in out.splitlines():
        f = nm_split(line)
        if len(f) != 3:
            continue
        try:
            signal = int(f[1])
        except ValueError:
            signal = 0
        yield f[0], signal, f[2] not in ("", "--")


def op_wifi_scan(req):
    try:
        saved = {p["ssid"] for p in wifi_profiles()}
    except Invalid:
        saved = set()
    best = {}
    for ssid, signal, secured in scan_entries():
        if not ssid:
            continue
        signal = max(0, min(100, signal))
        if ssid not in best or signal > best[ssid]["signal"]:
            best[ssid] = {"ssid": ssid, "signal": signal, "secured": secured, "saved": ssid in saved}
    return sorted(best.values(), key=lambda n: -n["signal"])


def _dbus_connect(ssid, psk):
    """comitup's D-Bus connect(ssid, password). Not busctl: the password must never be
    on a process argv (/proc/<pid>/cmdline is world-readable)."""
    try:
        import dbus  # python3-dbus comes with comitup; imported here so tests need no dbus
    except ImportError:
        log("wifi_add: python3-dbus is missing")
        raise Invalid("failed", JOIN_FAILED) from None
    try:
        obj = dbus.SystemBus().get_object(COMITUP[0], COMITUP[1])
        dbus.Interface(obj, COMITUP[2]).connect(ssid, psk, timeout=10)
    except dbus.DBusException as e:
        # the exception name only: its text could quote the arguments
        log(f"wifi_add: comitup connect failed ({type(e).__name__})")
        raise Invalid("failed", JOIN_FAILED) from None


COMITUP_CONNECT = _dbus_connect


def op_wifi_add(req):
    ssid, psk = req.get("ssid"), req.get("psk")
    check_ssid(ssid)
    if psk is None:
        psk = ""
    if psk != "" and not is_psk(psk):
        raise Invalid("invalid_value", CLIENT_PSK_MSG)
    COMITUP_CONNECT(ssid, psk)
    return {"connecting": True}


def op_wifi_forget(req):
    ssid = req.get("ssid")
    check_ssid(ssid)
    matches = [p for p in wifi_profiles() if p["ssid"] == ssid]
    if not matches:
        raise Invalid("invalid_value", "No saved network with that name.")
    for p in matches:
        rc, _ = RUN(["nmcli", "con", "delete", "uuid", p["uuid"]])
        if rc != 0:
            raise Invalid("failed", "Couldn't forget that network.")
    doc = load_settings()
    if ssid in doc["networks"]:
        new = copy.deepcopy(doc)
        del new["networks"][ssid]
        validate(new)
        write_settings(new)
        doc = new
    return {"settings": doc}


def op_tailscale_login(req):
    pin_gate(req.get("pin"))
    key = req.get("authkey")
    if not isinstance(key, str) or not AUTHKEY_RE.match(key):
        raise Invalid("invalid_value", "That doesn't look like a Tailscale auth key (tskey-...).")
    if not TAILSCALE_PRESENT():
        raise Invalid("failed", "Tailscale isn't installed on this PiFin.")
    # The key is on this argv, visible in /proc for up to 30 s: accepted, the tailscale CLI
    # has no stdin or file option for it. It is never stored and never logged.
    rc, _ = RUN(["tailscale", "up", "--reset", "--authkey=" + key,
                 "--hostname=" + socket.gethostname(), "--accept-routes=false"], timeout=30)
    if rc != 0:
        log(f"tailscale up failed (exit {rc})")
        raise Invalid("failed", "Tailscale sign-in failed. Check the key.")
    return None


def reboot_later():
    SLEEP(1)  # let the reply reach the caller first
    RUN(["systemctl", "reboot"])


def op_reboot(req):
    SPAWN(reboot_later)
    return None


def unlink_quiet(path):
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass


def remove_auth_json():
    """Delete auth.json without following a symlinked directory (the pifin user owns it)."""
    d, base = os.path.split(auth_path())
    try:
        dfd = open_dir(d, user_uid())
    except FileNotFoundError:
        return
    try:
        os.unlink(base, dir_fd=dfd)  # a symlink here is removed itself, never its target
    except FileNotFoundError:
        pass
    finally:
        os.close(dfd)


def factory_reset_now():
    SLEEP(1)  # let the reply reach the caller before anything goes away
    with LOCK:
        try:
            for p in wifi_profiles():
                RUN(["nmcli", "con", "delete", "uuid", p["uuid"]])
        except Invalid:
            log("factory reset: saved networks not readable, kept")
        for path in (SETTINGS, SECRETS, PAIR_TOKEN):
            unlink_quiet(P(path))
        try:
            remove_auth_json()
        except (OSError, Unsafe) as e:
            log(f"factory reset: auth.json not removed ({type(e).__name__})")
        log("factory reset done, rebooting")
        RUN(["systemctl", "reboot"])


def op_factory_reset(req):
    pin_gate(req.get("pin"))
    SPAWN(factory_reset_now)
    return None


# op -> (function, needs the store lock)
OPS = {
    "get": (op_get, False),
    "set": (op_set, True),
    "network_set": (op_network_set, True),
    "pin_set": (op_pin_set, True),
    "pin_clear": (op_pin_clear, True),
    "pin_check": (op_pin_check, True),
    "pair_reset": (op_pair_reset, True),
    "wifi_list": (op_wifi_list, False),
    "wifi_scan": (op_wifi_scan, False),
    "wifi_add": (op_wifi_add, True),
    "wifi_forget": (op_wifi_forget, True),
    "tailscale_login": (op_tailscale_login, True),
    "reboot": (op_reboot, False),
    "factory_reset": (op_factory_reset, True),
}
LOCK = threading.Lock()


def handle(req):
    """One request dict -> one response dict."""
    if not isinstance(req, dict) or not isinstance(req.get("op"), str):
        return {"ok": False, "error": "bad_request", "message": "Expected a JSON object with an op."}
    op = req["op"]
    if op not in OPS:
        return {"ok": False, "error": "bad_request", "message": f"Unknown op: {op[:32]}."}
    fn, locked = OPS[op]
    try:
        if locked:
            with LOCK:
                result = fn(req)
        else:
            result = fn(req)
        return {"ok": True, "result": result}
    except Invalid as e:
        return {"ok": False, "error": e.code, "message": e.message}
    except Exception as e:  # noqa: BLE001 -- the daemon must keep answering
        # type and file name only: an exception text could quote a value
        where = f" ({getattr(e, 'filename', '')})" if isinstance(e, OSError) else ""
        log(f"op {op} failed: {type(e).__name__}{where}")
        return {"ok": False, "error": "failed", "message": f"Internal error ({type(e).__name__})."}


def handle_line(line):
    try:
        req = json.loads(line)
    except ValueError:
        return {"ok": False, "error": "bad_request", "message": "Not JSON."}
    return handle(req)


# ---- socket ---------------------------------------------------------------

class Handler(socketserver.StreamRequestHandler):
    timeout = IDLE_TIMEOUT

    def handle(self):
        while True:
            try:
                line = self.rfile.readline(MAX_LINE + 1)
            except OSError:  # idle timeout or peer gone
                return
            if not line:
                return
            if len(line) > MAX_LINE:
                self.reply({"ok": False, "error": "bad_request", "message": "Request too long."})
                return
            self.reply(handle_line(line))

    def reply(self, resp):
        try:
            self.wfile.write((json.dumps(resp) + "\n").encode())
            self.wfile.flush()
        except OSError:
            pass


class Server(socketserver.ThreadingUnixStreamServer):
    daemon_threads = True


def make_server():
    gid = group_id()
    run_dir = P(RUN_DIR)
    os.makedirs(run_dir, exist_ok=True)
    chown(run_dir, 0, gid)
    os.chmod(run_dir, 0o750)
    sock = P(SOCK)
    try:
        os.unlink(sock)  # stale socket from a previous run
    except FileNotFoundError:
        pass
    server = Server(sock, Handler)
    os.chmod(sock, 0o660)
    chown(sock, 0, gid)
    return server


# ---- demo mode ------------------------------------------------------------

def fixture_runner(fdir):
    """A RUN that answers from captured command outputs in fdir and runs nothing.
    Commands that change something (delete, up, reboot, restart) succeed and do nothing."""
    def text(name):
        return read_text(os.path.join(fdir, name)) or ""

    wireless = []
    for line in text("con-show.txt").splitlines():
        f = nm_split(line)
        if len(f) == 4 and f[2] == "802-11-wireless":
            wireless.append(f[1])
    table = [
        (["nmcli", "-t", "-f", "NAME,UUID,TYPE,AUTOCONNECT-PRIORITY", "con", "show"], "con-show.txt"),
        (["nmcli", "-t", "-f", "SSID,SIGNAL,SECURITY", "dev", "wifi", "list"], "wifi-list.txt"),
        (["nmcli", "-t", "-f", "DEVICE,TYPE,STATE", "dev"], "dev-status.txt"),
        (["nmcli", "-g", "IP4.ADDRESS", "dev", "show"], "ip4.txt"),
        (["tailscale", "status", "--json"], "tailscale-status.json"),
        (["busctl", "--json=short", "call", "--system", *COMITUP, "access_points"], "comitup-aps.json"),
        (["busctl", "call", "--system", *COMITUP, "state"], "comitup-state.txt"),
    ]
    mode_cmd = ["nmcli", "-g", "802-11-wireless.mode,802-11-wireless.ssid", "con", "show"]

    def runner(argv, timeout=10):
        argv = [os.path.basename(argv[0])] + list(argv[1:])
        if any(word in argv for word in ("delete", "up", "reboot", "restart")):
            return 0, ""
        if argv[:5] == mode_cmd and len(argv) == 6 and argv[5] in wireless:
            return 0, text(f"con-mode-{wireless.index(argv[5]) + 1}.txt")
        if argv == [os.path.basename(PIFIN_BIN), "--version"]:
            return 0, "pifin demo\n"
        for prefix, name in table:
            if argv[:len(prefix)] == prefix:
                return 0, text(name)
        return 1, ""
    return runner


def use_demo(fdir):
    global RUN, COMITUP_CONNECT, TAILSCALE_PRESENT
    RUN = fixture_runner(fdir)
    COMITUP_CONNECT = lambda ssid, psk: None  # noqa: E731 -- no dbus import in demo mode
    TAILSCALE_PRESENT = lambda: os.path.exists(os.path.join(fdir, "tailscale-status.json"))  # noqa: E731


def main():
    os.umask(0o077)  # the socket stays private until its chmod
    if len(sys.argv) == 3 and sys.argv[1] == "--demo":
        if not root():
            sys.exit("pifin-settingsd: --demo needs PIFIN_ROOT (a scratch directory for the store)")
        use_demo(sys.argv[2])
        log(f"demo mode: answers from {sys.argv[2]}, runs no command")
    elif len(sys.argv) != 1:
        sys.exit("usage: pifin-settingsd [--demo <fixture dir>]")
    init()
    server = make_server()
    log("listening")
    # Requests wake the selector; the poll interval only bounds how fast shutdown() is
    # noticed, and nothing calls it. The default 0.5 s woke the idle daemon twice a second.
    server.serve_forever(poll_interval=IDLE_POLL)


if __name__ == "__main__":
    main()
