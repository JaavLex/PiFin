WIFI_JSON = "/run/pifin/wifi.json"
APP_CONF = "/etc/pifin/app.conf"
DISPLAY_CONF = "/etc/pifin/display.conf"
SECRETS_ENV = "/etc/pifin/secrets.env"
COMITUP_CONF = "/etc/comitup.conf"
PIFIN_BIN = "/usr/local/bin/pifin"
TAILSCALE = "/usr/bin/tailscale"
COMITUP = ["com.github.davesteele.comitup", "/com/github/davesteele/comitup",
           "com.github.davesteele.comitup"]

