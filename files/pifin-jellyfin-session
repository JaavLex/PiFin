#!/bin/sh
# Runs inside cage. Picks a display mode that fits whatever screen is plugged
# in, starts a fullscreen (rootful) Xwayland of exactly that size, and launches
# Jellyfin Desktop on it through X11.
#
# Mode policy: the screen's native/preferred mode, capped at MAX_HEIGHT
# (default 720p, set in /etc/pifin/display.conf). The TV scales it to full
# screen. Every video frame goes through several full-screen GPU passes
# (mpv -> Qt -> Xwayland -> cage) and at 1080p the Pi 4 GPU can't keep up with
# 30 fps video; at 720p each pass draws 56% fewer pixels. Many 4K TVs also
# prefer 4K@24Hz, which makes the UI choppy. Refresh closest to 60Hz wins.
#
# Why X11: on the Pi 4 the display (vc4) and the 3D engine (v3d) are separate
# devices. Under Wayland, the Mesa shipped in the Flatpak runtime is handed the
# vc4 display device and falls back to llvmpipe (software rendering). Through
# Xwayland/DRI3 it gets the v3d render node and real GPU acceleration.

log() { echo "pifin-session: $*" >&2; }

MAX_HEIGHT=720
[ -r /etc/pifin/display.conf ] && . /etc/pifin/display.conf

OUTPUTS=$(wlr-randr --json 2>/dev/null)
OUT=$(echo "$OUTPUTS" | jq -r '[.[] | select(.enabled)][0].name // empty')

if [ -n "$OUT" ]; then
  # preferred mode, or the largest one if the screen doesn't flag one
  PREF=$(echo "$OUTPUTS" | jq -r --arg o "$OUT" '
    (.[] | select(.name == $o) | .modes) as $m
    | ([$m[] | select(.preferred)][0] // ($m | max_by(.width * .height)))
    | "\(.width) \(.height)"')
  set -- $PREF
  PW=$1; PH=$2
  if [ "$PH" -gt "$MAX_HEIGHT" ]; then CAPH=$MAX_HEIGHT; CAPW=$((MAX_HEIGHT * 16 / 9)); else CAPW=$PW; CAPH=$PH; fi
  # refresh closest to 60Hz at the target size (120Hz modes waste GPU and
  # don't help video); fall back to the largest mode <= MAX_HEIGHT
  MODE=$(echo "$OUTPUTS" | jq -r --arg o "$OUT" --argjson w "$CAPW" --argjson h "$CAPH" --argjson mh "$MAX_HEIGHT" '
    (.[] | select(.name == $o) | .modes) as $m
    | ([$m[] | select(.width == $w and .height == $h)]
       | (map(select(.refresh <= 61)) | max_by(.refresh)) // min_by(.refresh))
      // ([$m[] | select(.height <= $mh)] | max_by(.width * .height * 1000 + (if .refresh <= 61 then .refresh else 0 end)))
    | "\(.width)x\(.height)@\(.refresh)Hz"')
  log "output $OUT: preferred ${PW}x${PH}, using $MODE"
  wlr-randr --output "$OUT" --mode "$MODE" || log "mode switch failed"
  sleep 1
  SIZE=$(wlr-randr --json | jq -r --arg o "$OUT" '.[] | select(.name == $o) | .modes[] | select(.current) | "\(.width)x\(.height)"')
fi
SIZE=${SIZE:-1920x1080}
log "Xwayland size $SIZE"

Xwayland :1 -fullscreen -geometry "$SIZE" -host-grab -nolisten tcp -noreset &
for i in $(seq 1 100); do
  [ -S /tmp/.X11-unix/X1 ] && break
  sleep 0.1
done
export DISPLAY=:1

# kiosk window manager: every window fills the screen, no title bars
matchbox-window-manager -use_titlebar no -use_cursor no &

exec /usr/bin/flatpak run \
  --device=all --socket=x11 --nosocket=wayland \
  --env=QT_QPA_PLATFORM=xcb \
  --env=QTWEBENGINE_CHROMIUM_FLAGS=--ignore-gpu-blocklist \
  org.jellyfin.JellyfinDesktop --tv --fullscreen --remote-debugging-port=9222
