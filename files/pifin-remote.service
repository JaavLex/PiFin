[Unit]
Description=PiFin phone remote (web app on port 8080) + TV hint overlay
After=network-online.target jellyfin-kiosk.service
Wants=network-online.target

[Service]
EnvironmentFile=-/etc/pifin/secrets.env
ExecStart=/usr/bin/python3 /opt/pifin-remote/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
