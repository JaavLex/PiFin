[Unit]
Description=PiFin settings service (the only writer of the settings)
After=local-fs.target
# first boot of the ready-made image: start once pifin-setup.sh has written the
# hotspot password, so the store is migrated from complete legacy files
After=pifin-setup.service

[Service]
ExecStart=/usr/bin/python3 /usr/local/sbin/pifin-settingsd
Restart=always
RestartSec=2
StateDirectory=pifin
# No RuntimeDirectory=: it would reset the owner of /run/pifin (and wifi.json) on every
# start. The daemon itself creates its socket root:pifin 0660 and removes a stale one.
ExecStartPre=+/usr/bin/install -d -o root -g @@PIFIN_USER@@ -m 0750 /run/pifin
ProtectSystem=strict
# /etc/comitup.conf is edited in place (no temp file can be made in a read-only /etc).
# The "-"s keep the unit starting when a path is missing: /run/pifin early at boot (the
# ExecStartPre above creates it; without the "-" its own namespace setup fails, 226/NAMESPACE),
# the config dir when nobody has signed in yet.
ReadWritePaths=/var/lib/pifin -/run/pifin /etc/pifin /etc/comitup.conf -/home/@@PIFIN_USER@@/.config/pifin
ProtectHome=no
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
RestrictAddressFamilies=AF_UNIX AF_NETLINK
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
