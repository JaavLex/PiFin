// PiFin UI. Designed at 1280x720 logical px (SLINT_SCALE_FACTOR=1.5 at 1080p);
// driven by arrows, OK and Back only. Nothing animates: the window only redraws
// when focus or content changes, so it idles at 0 redraws while mpv plays.

export struct Card {
    id: string,
    title: string,
    subtitle: string,
    image: image,
    has-image: bool,
    progress: float,   // 0..1 resume position, 0 = none
}

export struct Row {
    title: string,
    cards: [Card],
    focus: int,        // remembered column
}

component PosterCard inherits Rectangle {
    in property <Card> card;
    in property <bool> focused;
    width: 150px;
    height: 225px + 50px;

    Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: 225px;
        border-radius: 10px;
        background: card.has-image ? transparent : #1a1c2b;
        if !card.has-image: Text {
            text: card.title;
            color: #8e8ea6;
            wrap: word-wrap;
            horizontal-alignment: center;
            width: parent.width - 16px;
        }
        if card.has-image: Image {
            x: 0; y: 0;
            width: 150px;
            height: 225px;
            source: card.image;
            image-fit: cover;
        }
        if card.progress > 0: Rectangle {
            y: parent.height - 6px;
            height: 6px;
            width: parent.width;
            background: #00000099;
            Rectangle {
                x: 0;
                width: parent.width * card.progress;
                background: #00a4dc;
            }
        }
    }
    // focus ring drawn outside the clip so it stays crisp
    Rectangle {
        width: parent.width + 8px;
        height: 225px + 8px;
        x: -4px;
        y: -4px;
        border-radius: 13px;
        border-width: focused ? 3px : 0px;
        border-color: #ffffff;
    }
    Text {
        x: 0; y: 225px + 10px;
        width: parent.width; height: 18px;
        vertical-alignment: top;
        text: card.title;
        color: focused ? #f2f2f7 : #9a9ab0;
        font-size: 15px;
        font-weight: focused ? 600 : 400;
        overflow: elide;
    }
    Text {
        x: 0; y: 225px + 30px;
        width: parent.width; height: 16px;
        vertical-alignment: top;
        text: card.subtitle;
        color: #6e6e86;
        font-size: 13px;
        overflow: elide;
    }
}

export component App inherits Window {
    title: "PiFin";
    preferred-width: 1280px;
    preferred-height: 720px;
    background: #0b0b12;
    default-font-size: 18px;

    in property <[Row]> rows;
    in-out property <int> cur-row: 0;
    in property <image> backdrop;
    in property <bool> has-backdrop: false;
    in property <string> heading: "";
    in property <string> info: "";
    in property <string> overview: "";
    in property <string> status: "";
    callback moved(int, int);      // row, column after a move
    callback activate(int, int);   // row, column
    callback back();
    callback unknown-key(string);

    // Wi-Fi screen (shown over everything while the Pi has no network)
    in property <bool> wifi-show: false;
    in property <string> wifi-title;
    in property <string> wifi-text;
    in property <string> wifi-error;
    in property <image> wifi-qr;
    in property <bool> wifi-has-qr: false;

    // phone remote hint (bottom right) shown at boot
    in-out property <bool> remote-show: false;
    in property <image> remote-qr;
    in property <string> remote-url;

    property <length> row-h: 330px;
    property <length> card-step: 166px;

    // backdrop of the focused item, dimmed so text stays readable
    if root.has-backdrop: Image {
        width: parent.width;
        height: parent.height;
        source: root.backdrop;
        image-fit: fill;
    }

    // header: focused item details
    Text {
        x: 64px; y: 36px;
        width: 760px;
        text: root.heading;
        font-size: 36px; font-weight: 700;
        color: #f2f2f7;
        overflow: elide;
    }
    Text {
        x: 64px; y: 86px;
        text: root.info;
        color: #b4b4c8;
        font-size: 17px;
    }
    Text {
        x: 64px; y: 116px;
        width: 700px; height: 72px;
        text: root.overview;
        color: #9a9ab0;
        font-size: 15px;
        wrap: word-wrap;
        overflow: elide;
    }
    Text {
        x: parent.width - self.width - 64px; y: 40px;
        text: root.status;
        color: #6e6e86;
        font-size: 15px;
    }

    // rows: the focused row sits at the top of the list area
    Rectangle {
        x: 0; y: 210px;
        width: parent.width; height: parent.height - 210px;
        clip: true;
        for r[ri] in root.rows: Rectangle {
            y: (ri - root.cur-row) * root.row-h + 8px;
            width: parent.width;
            height: root.row-h;
            visible: ri >= root.cur-row && ri <= root.cur-row + 2;
            Text {
                x: 64px; y: 0;
                text: r.title;
                font-size: 20px; font-weight: 600;
                color: ri == root.cur-row ? #f2f2f7 : #8e8ea6;
            }
            for c[ci] in r.cards: PosterCard {
                x: 64px + (ci - max(0, r.focus - 5)) * root.card-step;
                y: 36px;
                card: c;
                focused: ri == root.cur-row && ci == r.focus;
                visible: self.x > -self.width && self.x < root.width;
            }
        }
    }

    if root.remote-show && !root.wifi-show: Rectangle {
        x: parent.width - self.width - 40px; y: parent.height - self.height - 32px;
        width: 360px; height: 160px;
        border-radius: 16px;
        background: #161826f0;
        Rectangle {
            x: 16px; y: 20px; width: 120px; height: 120px;
            background: white; border-radius: 8px;
            Image { x: 8px; y: 8px; width: 104px; height: 104px; source: root.remote-qr; image-rendering: pixelated; }
        }
        Text { x: 152px; y: 28px; text: "Phone remote"; font-size: 20px; font-weight: 700; color: #f2f2f7; }
        Text { x: 152px; y: 60px; width: 196px; text: "Scan, or open " + root.remote-url + " on a phone on this Wi-Fi."; font-size: 14px; color: #9a9ab0; wrap: word-wrap; }
        Text { x: 152px; y: 128px; text: "Back to hide"; font-size: 13px; color: #6e6e86; }
    }

    if root.wifi-show: Rectangle {
        background: #0b0b12;
        Text {
            x: 96px; y: 120px;
            text: root.wifi-title;
            font-size: 40px; font-weight: 700;
            color: #f2f2f7;
        }
        Text {
            x: 96px; y: 190px;
            width: root.wifi-has-qr ? 640px : parent.width - 192px;
            text: root.wifi-text;
            font-size: 22px;
            color: #b4b4c8;
            wrap: word-wrap;
        }
        Text {
            x: 96px; y: parent.height - 140px;
            width: 640px;
            text: root.wifi-error;
            font-size: 22px;
            color: #ff9f9f;
            wrap: word-wrap;
        }
        if root.wifi-has-qr: Rectangle {
            x: parent.width - 96px - 380px; y: (parent.height - 380px) / 2;
            width: 380px; height: 380px;
            background: white;
            border-radius: 16px;
            Image {
                x: 20px; y: 20px;
                width: 340px; height: 340px;
                source: root.wifi-qr;
                image-rendering: pixelated;
            }
        }
    }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (root.rows.length == 0) { return reject; }
            if (event.text == Key.RightArrow) { root.moved(root.cur-row, root.rows[root.cur-row].focus + 1); return accept; }
            if (event.text == Key.LeftArrow) { root.moved(root.cur-row, root.rows[root.cur-row].focus - 1); return accept; }
            if (event.text == Key.DownArrow) { root.moved(root.cur-row + 1, -1); return accept; }
            if (event.text == Key.UpArrow) { root.moved(root.cur-row - 1, -1); return accept; }
            if (event.text == Key.Return || event.text == " ") { root.activate(root.cur-row, root.rows[root.cur-row].focus); return accept; }
            if (event.text == Key.Escape || event.text == Key.Backspace) { root.back(); return accept; }
            root.unknown-key(event.text);
            return reject;
        }
    }
}
