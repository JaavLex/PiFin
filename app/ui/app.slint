// PiFin UI. Designed at 1280x720 logical px (SLINT_SCALE_FACTOR=1.5 at 1080p);
// driven by arrows, OK and Back only. Nothing animates: the window only redraws
// when focus or content changes, so it idles at 0 redraws while mpv plays.

export struct Card {
    id: string,
    title: string,
    subtitle: string,
    image: image,
    has-image: bool,
    progress: float,   // 0..1 resume position, 0 = none
}

export struct Row {
    title: string,
    cards: [Card],
    focus: int,        // remembered column
}

// one line of the Settings screen; kind: "choice" | "toggle" | "action" | "text" | "info"
export struct SettingRow { key: string, kind: string, label: string, value: string, locked: bool }

// on-screen keyboard (search and text entry): 46x27 keys on a 50x30 px step
component KeyGrid {
    in property <[string]> keys;
    in property <int> focused-key;   // (`focus` is a built-in function name)
    in property <bool> active: true;
    in property <int> cols: 10;
    in property <string> shift-label: "ABC";
    in property <string> sym-label: "#+=";
    for key[i] in root.keys: Rectangle {
        property <bool> focused: root.active && i == root.focused-key;
        x: mod(i, root.cols) * 50px;
        y: floor(i / root.cols) * 30px;
        width: 46px;
        height: 27px;
        border-radius: 6px;
        background: focused ? #00a4dc : #1a1c2b;
        Text {
            text: key == "space" ? "␣" : key == "delete" ? "⌫" : key == "clear" ? "✕" : key == "done" ? "OK"
                : key == "shift" ? root.shift-label : key == "sym" ? root.sym-label : key;
            color: focused ? #0b0b12 : #c8c8d8;
            font-size: 16px;
            font-weight: focused ? 700 : 400;
        }
    }
}

component PosterCard inherits Rectangle {
    in property <Card> card;
    in property <bool> focused;
    width: 150px;
    height: 225px + 50px;

    Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: 225px;
        border-radius: 10px;
        background: card.has-image ? transparent : #1a1c2b;
        if !card.has-image: Text {
            text: card.title;
            color: #8e8ea6;
            wrap: word-wrap;
            horizontal-alignment: center;
            width: parent.width - 16px;
        }
        if card.has-image: Image {
            x: 0; y: 0;
            width: 150px;
            height: 225px;
            source: card.image;
            image-fit: cover;
        }
        if card.progress > 0: Rectangle {
            y: parent.height - 6px;
            height: 6px;
            width: parent.width;
            background: #00000099;
            Rectangle {
                x: 0;
                width: parent.width * card.progress;
                background: #00a4dc;
            }
        }
    }
    // focus ring drawn outside the clip so it stays crisp
    Rectangle {
        width: parent.width + 8px;
        height: 225px + 8px;
        x: -4px;
        y: -4px;
        border-radius: 13px;
        border-width: focused ? 3px : 0px;
        border-color: #ffffff;
    }
    Text {
        x: 0; y: 225px + 10px;
        width: parent.width; height: 18px;
        vertical-alignment: top;
        text: card.title;
        color: focused ? #f2f2f7 : #9a9ab0;
        font-size: 15px;
        font-weight: focused ? 600 : 400;
        overflow: elide;
    }
    Text {
        x: 0; y: 225px + 30px;
        width: parent.width; height: 16px;
        vertical-alignment: top;
        text: card.subtitle;
        color: #6e6e86;
        font-size: 13px;
        overflow: elide;
    }
}

export component App inherits Window {
    title: "PiFin";
    no-frame: true;   // no client-side title bar (it cost 35 px at the bottom under cage)
    preferred-width: 1280px;
    preferred-height: 720px;
    background: #0b0b12;
    default-font-size: 18px;

    in property <[Row]> rows;
    in-out property <int> cur-row: 0;
    in property <image> backdrop;
    in property <bool> has-backdrop: false;
    in property <string> heading: "";
    in property <string> info: "";
    in property <string> overview: "";
    in property <string> status: "";
    in property <image> logo;
    callback moved(int, int);      // row, column after a move
    callback activate(int, int);   // row, column
    callback back();
    callback unknown-key(string);

    // search screen: on-screen keyboard over the header, results in the rows
    in property <bool> search-mode: false;
    in property <string> query;
    in property <[string]> kb-keys;
    in-out property <int> kb-focus: 0;
    in-out property <bool> kb-active: true;
    property <int> kb-cols: 10;
    callback open-search();
    // top bar on the home screen: search and the signed-in user (↑ from the first row)
    in property <bool> nav-show: false;
    in-out property <int> nav-focus: -1;   // -1 rows, 0 search, 1 settings, 2 user
    in property <string> user-name;
    in property <string> user-initial;
    in property <int> user-index: 0;      // same colour as on "Who's watching?"
    in property <image> user-image;
    in property <bool> user-has-image: false;
    callback open-profiles();
    callback kb-press(string);

    // Settings screen (gear in the top bar); settings_ui.rs builds the rows and runs the overlays
    in property <bool> settings-show: false;
    in property <[string]> settings-sections;
    in-out property <int> settings-section: 1;
    in property <[SettingRow]> settings-rows;
    in-out property <int> settings-row: -1;   // -1 = focus on the section list
    in property <string> settings-message;    // "!" prefix = error (stripped here, drawn red)
    property <int> settings-top: max(0, min(root.settings-rows.length - 9, root.settings-row - 4));
    callback open-settings();
    callback settings-close();
    callback settings-section-changed(int);
    callback settings-step(string, int);      // key, -1 | +1 (choice/toggle)
    callback settings-activate(string);       // key (OK on any non-info row)
    callback settings-move(int);              // -1 | +1: Rust picks the next non-info row
    // list picker: the visible window (at most 9 items)
    in property <bool> picker-show: false;
    in property <string> picker-title;
    in property <[string]> picker-items;
    in property <int> picker-sel;
    callback picker-move(int);
    callback picker-ok();
    callback picker-cancel();
    // PIN digit pad
    in property <bool> pad-show: false;
    in property <string> pad-title;
    in property <int> pad-len;
    in property <string> pad-error;
    in-out property <int> pad-focus: 0;
    property <[string]> pad-labels: ["1", "2", "3", "4", "5", "6", "7", "8", "9", "⌫", "0", "OK"];
    callback pad-key(string);   // "0".."9" | "del" | "ok" | "cancel"
    // confirmation: [Cancel] [confirm-yes]
    in property <bool> confirm-show: false;
    in property <string> confirm-title;
    in property <string> confirm-text;
    in property <string> confirm-yes;
    in-out property <int> confirm-focus: 0;
    callback confirm-done(bool);
    // phone remote panel (Settings > System): QR with the token, address, [Back] [Re-pair]
    in property <bool> pair-show: false;
    in property <image> pair-qr;
    in property <bool> pair-has-qr: false;
    in property <string> pair-url;
    in property <string> pair-note;
    in-out property <int> pair-focus: 0;
    callback pair-done(bool);
    // text entry over the rows area
    in property <bool> te-show: false;
    in property <string> te-title;
    in property <string> te-value;
    in property <[string]> te-keys;
    in-out property <int> te-focus: 0;
    callback te-key(string);

    // Wi-Fi screen (shown over everything while the Pi has no network)
    in property <bool> wifi-show: false;
    in property <string> wifi-title;
    in property <string> wifi-text;
    in property <string> wifi-error;
    in property <image> wifi-qr;
    in property <bool> wifi-has-qr: false;
    in property <bool> wifi-pickable: false;   // the hotspot screen: OK picks a network here
    callback wifi-pick();

    // playback starting: shown from Play until mpv's first frame covers the app
    in property <bool> starting: false;
    in property <string> starting-title;
    in property <bool> starting-slow: false;
    in property <string> starting-note;   // e.g. lower quality for a weak connection
    callback cancel-start();

    // "Who's watching?": saved users plus an "Add user" card (id "add")
    in property <bool> profiles-show: false;
    in property <[Card]> profiles;
    in-out property <int> profile-focus: 0;
    property <[color]> profile-colors: [#00a4dc, #aa5cc3, #e8a33d, #3dbb7e, #e2566b];
    callback profile-pick(int);
    callback profile-close();
    // Back on the sign-in screen (only acts when adding a user)
    callback cancel();

    // phone remote hint (bottom right) shown at boot
    in-out property <bool> remote-show: false;
    in property <image> remote-qr;
    in property <string> remote-url;

    property <length> row-h: 330px;
    property <length> card-step: 166px;

    // backdrop of the focused item, dimmed so text stays readable
    if root.has-backdrop: Image {
        width: parent.width;
        height: parent.height;
        source: root.backdrop;
        image-fit: fill;
    }

    // header: focused item details
    Text {
        x: 64px; y: 36px;
        width: root.nav-show ? 564px : 760px;
        visible: !root.search-mode;
        text: root.heading;
        font-size: 36px; font-weight: 700;
        color: #f2f2f7;
        overflow: elide;
    }
    Text {
        x: 64px; y: 86px;
        visible: !root.search-mode;
        text: root.info;
        color: #b4b4c8;
        font-size: 17px;
    }
    Text {
        x: 64px; y: 116px;
        width: 700px; height: 72px;
        visible: !root.search-mode;
        text: root.overview;
        color: #9a9ab0;
        font-size: 15px;
        wrap: word-wrap;
        overflow: elide;
    }
    Image {
        x: parent.width - self.width - 56px; y: 30px;
        width: 150px; height: 44px;
        source: root.logo;
        visible: !root.search-mode;
    }
    // top bar: [search] [gear] [avatar name], left of the logo
    if root.nav-show && !root.search-mode: Rectangle {
        property <bool> f-search: root.nav-focus == 0;
        property <bool> f-gear: root.nav-focus == 1;
        property <bool> f-user: root.nav-focus == 2;
        x: parent.width - 56px - 150px - 24px - self.width; y: 30px;
        width: user-pill.x + user-pill.width; height: 44px;
        Rectangle {
            x: 0; width: 150px; height: 44px;
            border-radius: 22px;
            background: f-search ? #f2f2f7 : #1a1c2bd8;
            Path {
                x: 16px; y: 12px; width: 20px; height: 20px;
                viewbox-width: 20; viewbox-height: 20;
                commands: "M 8.5 2 A 6.5 6.5 0 1 0 8.5 15 A 6.5 6.5 0 1 0 8.5 2 M 13.5 13.5 L 18.5 18.5";
                stroke: f-search ? #0b0b12 : #c8c8d8;
                stroke-width: 2.4px;
            }
            Text {
                x: 46px; height: parent.height;
                vertical-alignment: center;
                text: "Search";
                font-size: 18px;
                font-weight: 600;   // same width focused or not: the bar doesn't shift
                color: f-search ? #0b0b12 : #c8c8d8;
            }
        }
        Rectangle {
            x: 162px; width: 44px; height: 44px;
            border-radius: 22px;
            background: f-gear ? #f2f2f7 : #1a1c2bd8;
            Path {
                x: 11px; y: 11px; width: 22px; height: 22px;
                viewbox-width: 20; viewbox-height: 20;
                commands: "M 16.5 10 A 6.5 6.5 0 1 0 3.5 10 A 6.5 6.5 0 1 0 16.5 10 M 12.8 10 A 2.8 2.8 0 1 0 7.2 10 A 2.8 2.8 0 1 0 12.8 10 M 16.5 10 L 19 10 M 14.6 14.6 L 16.4 16.4 M 10 16.5 L 10 19 M 5.4 14.6 L 3.6 16.4 M 3.5 10 L 1 10 M 5.4 5.4 L 3.6 3.6 M 10 3.5 L 10 1 M 14.6 5.4 L 16.4 3.6";
                stroke: f-gear ? #0b0b12 : #c8c8d8;
                stroke-width: 2.2px;
            }
        }
        user-pill := Rectangle {
            x: 218px; height: 44px;
            width: min(176px, 52px + name.preferred-width + 18px);
            border-radius: 22px;
            background: f-user ? #f2f2f7 : #1a1c2bd8;
            Rectangle {
                x: 4px; y: 4px; width: 36px; height: 36px;
                border-radius: 18px;
                background: root.user-has-image ? transparent : root.profile-colors[mod(root.user-index, root.profile-colors.length)];
                if !root.user-has-image: Text {
                    text: root.user-initial;
                    font-size: 18px; font-weight: 700;
                    color: #0b0b12;
                }
                if root.user-has-image: Image { width: 36px; height: 36px; source: root.user-image; }
            }
            name := Text {
                x: 50px; height: parent.height;
                width: parent.width - 50px - 16px;
                vertical-alignment: center;
                text: root.user-name;
                font-size: 18px;
                font-weight: 600;   // same width focused or not: the bar doesn't shift
                color: f-user ? #0b0b12 : #c8c8d8;
                overflow: elide;
            }
        }
    }
    Text {
        x: parent.width - self.width - 64px; y: 84px;
        text: root.status;
        color: #6e6e86;
        font-size: 15px;
    }

    if root.search-mode: Rectangle {
        x: 64px; y: 22px;
        width: parent.width - 128px; height: 180px;
        Rectangle {
            x: 0; y: 0; width: 420px; height: 44px;
            border-radius: 10px;
            background: #1a1c2b;
            Text {
                x: 16px;
                text: root.query == "" ? "Search movies and shows" : root.query;
                color: root.query == "" ? #6e6e86 : #f2f2f7;
                font-size: 22px;
                vertical-alignment: center;
                height: parent.height;
            }
        }
        Text { x: 440px; y: 12px; text: root.kb-active ? "↓ results" : "↑ keyboard"; color: #6e6e86; font-size: 15px; }
        KeyGrid {
            x: 0; y: 56px;
            keys: root.kb-keys;
            focused-key: root.kb-focus;
            active: root.kb-active;
            cols: root.kb-cols;
        }
    }

    // rows: the focused row sits at the top of the list area
    Rectangle {
        x: 0; y: 210px;
        width: parent.width; height: parent.height - 210px;
        clip: true;
        for r[ri] in root.rows: Rectangle {
            y: (ri - root.cur-row) * root.row-h + 8px;
            width: parent.width;
            height: root.row-h;
            visible: ri >= root.cur-row && ri <= root.cur-row + 2;
            Text {
                x: 64px; y: 0;
                text: r.title;
                font-size: 20px; font-weight: 600;
                color: ri == root.cur-row ? #f2f2f7 : #8e8ea6;
            }
            for c[ci] in r.cards: PosterCard {
                x: 64px + (ci - max(0, r.focus - 5)) * root.card-step;
                y: 36px;
                card: c;
                focused: ri == root.cur-row && ci == r.focus && root.nav-focus < 0;
                visible: self.x > -self.width && self.x < root.width;
            }
        }
    }

    if root.remote-show && !root.wifi-show: Rectangle {
        x: parent.width - self.width - 40px; y: parent.height - self.height - 32px;
        width: 360px; height: 160px;
        border-radius: 16px;
        background: #161826f0;
        Rectangle {
            x: 16px; y: 20px; width: 120px; height: 120px;
            background: white; border-radius: 8px;
            Image { x: 8px; y: 8px; width: 104px; height: 104px; source: root.remote-qr; image-rendering: pixelated; }
        }
        Text { x: 152px; y: 28px; text: "Phone remote"; font-size: 20px; font-weight: 700; color: #f2f2f7; }
        Text { x: 152px; y: 60px; width: 196px; text: "Scan, or open " + root.remote-url + " on a phone on this Wi-Fi."; font-size: 14px; color: #9a9ab0; wrap: word-wrap; }
        Text { x: 152px; y: 128px; text: "Back to hide"; font-size: 13px; color: #6e6e86; }
    }

    if root.wifi-show: Rectangle {
        background: #0b0b12;
        Text {
            x: 96px; y: 120px;
            text: root.wifi-title;
            font-size: 40px; font-weight: 700;
            color: #f2f2f7;
        }
        Text {
            x: 96px; y: 190px;
            width: root.wifi-has-qr ? 640px : parent.width - 192px;
            text: root.wifi-text;
            font-size: 22px;
            color: #b4b4c8;
            wrap: word-wrap;
        }
        Text {
            x: 96px; y: parent.height - 140px;
            width: 640px;
            text: root.wifi-error;
            font-size: 22px;
            color: #ff9f9f;
            wrap: word-wrap;
        }
        if root.wifi-has-qr: Rectangle {
            x: parent.width - 96px - 380px; y: (parent.height - 380px) / 2;
            width: 380px; height: 380px;
            background: white;
            border-radius: 16px;
            Image {
                x: 20px; y: 20px;
                width: 340px; height: 340px;
                source: root.wifi-qr;
                image-rendering: pixelated;
            }
        }
    }

    if root.starting: Rectangle {
        background: #0b0b12e8;
        // the only animation in the app, and only while a video starts
        property <float> phase: mod(animation-tick() / 110ms, 8);
        for i in 8: Rectangle {
            width: 14px; height: 14px; border-radius: 7px;
            x: parent.width / 2 - 7px + 34px * cos(i * 45deg);
            y: parent.height / 2 - 67px + 34px * sin(i * 45deg);
            background: #00a4dc;
            opacity: 1 - mod(parent.phase - i + 8, 8) / 8;
        }
        Text {
            y: parent.height / 2 + 10px; width: parent.width;
            horizontal-alignment: center;
            text: root.starting-title;
            font-size: 26px; font-weight: 700; color: #f2f2f7;
            overflow: elide;
        }
        Text {
            y: parent.height / 2 + 52px; width: parent.width;
            horizontal-alignment: center;
            text: root.starting-slow ? "Still buffering: the connection to the server is slow  ·  Back to cancel"
                : root.starting-note != "" ? "Starting, " + root.starting-note + "  ·  Back to cancel"
                : "Starting…  ·  Back to cancel";
            font-size: 16px; color: #8e8ea6;
        }
    }

    if root.profiles-show: Rectangle {
        background: #0b0b12;
        Image {
            x: parent.width - self.width - 56px; y: 30px;
            width: 150px; height: 44px;
            source: root.logo;
        }
        Text {
            y: 170px; width: parent.width;
            horizontal-alignment: center;
            text: "Who's watching?";
            font-size: 40px; font-weight: 700;
            color: #f2f2f7;
        }
        for p[i] in root.profiles: Rectangle {
            property <bool> focused: i == root.profile-focus;
            property <length> step: 200px;
            x: (parent.width - root.profiles.length * self.step) / 2 + i * self.step + 20px;
            y: 270px;
            width: 160px; height: 220px;
            // focus ring
            Rectangle {
                x: -6px; y: -6px; width: 172px; height: 172px;
                border-radius: 86px;
                border-width: focused ? 4px : 0px;
                border-color: #ffffff;
            }
            Rectangle {
                width: 160px; height: 160px; x: 0; y: 0;
                border-radius: 80px;
                background: p.id == "add" ? #1a1c2b : p.has-image ? transparent : root.profile-colors[mod(i, root.profile-colors.length)];
                if !p.has-image: Text {
                    text: p.id == "add" ? "+" : p.title == "" ? "?" : p.subtitle;
                    font-size: 64px; font-weight: 700;
                    color: p.id == "add" ? #8e8ea6 : #0b0b12;
                }
                if p.has-image: Image { width: 160px; height: 160px; source: p.image; }
            }
            Text {
                y: 180px; width: parent.width;
                horizontal-alignment: center;
                text: p.title;
                font-size: 20px;
                font-weight: focused ? 700 : 400;
                color: focused ? #f2f2f7 : #8e8ea6;
                overflow: elide;
            }
        }
        Text {
            y: parent.height - 80px; width: parent.width;
            horizontal-alignment: center;
            text: root.rows.length > 0 ? "OK to choose  ·  Back to stay" : "OK to choose";
            font-size: 15px; color: #6e6e86;
        }
    }

    // Settings: section list on the left, rows of the current section on the right
    if root.settings-show: Rectangle {
        background: #0b0b12;
        Text {
            x: 64px; y: 36px;
            text: "Settings";
            font-size: 36px; font-weight: 700;
            color: #f2f2f7;
        }
        for s[i] in root.settings-sections: Rectangle {
            property <bool> current: i == root.settings-section;
            property <bool> focused: current && root.settings-row < 0;
            x: 64px; y: 120px + i * 52px;
            width: 260px; height: 44px;
            border-radius: 22px;
            background: focused ? #f2f2f7 : current ? #1a1c2b : transparent;
            Text {
                x: 20px; height: parent.height;
                vertical-alignment: center;
                text: s;
                font-size: 20px;
                font-weight: 600;   // same width focused or not
                color: focused ? #0b0b12 : current ? #f2f2f7 : #8e8ea6;
            }
        }
        Rectangle {
            x: 360px; y: 120px;
            width: 856px; height: 9 * 56px;
            clip: true;
            for r[i] in root.settings-rows: Rectangle {
                property <bool> focused: i == root.settings-row;
                y: (i - root.settings-top) * 56px;
                width: parent.width; height: 52px;
                visible: i >= root.settings-top && i < root.settings-top + 9;
                border-radius: 10px;
                background: focused ? #1a1c2b : transparent;
                border-width: focused ? 3px : 0px;
                border-color: #ffffff;
                Text {
                    x: 20px; width: 380px; height: parent.height;
                    vertical-alignment: center;
                    text: r.label;
                    font-size: 18px;
                    color: #c8c8d8;
                    overflow: elide;
                }
                value := Text {
                    width: min(self.preferred-width, 420px);
                    x: parent.width - 20px - self.width; height: parent.height;
                    vertical-alignment: center;
                    text: r.kind == "choice" ? "‹  " + r.value + "  ›" : r.value;
                    font-size: 18px;
                    color: #9a9ab0;
                    overflow: elide;
                }
                if r.locked: Path {
                    x: value.x - 24px; y: (parent.height - 18px) / 2;
                    width: 16px; height: 18px;
                    viewbox-width: 16; viewbox-height: 18;
                    commands: "M 2 8 L 14 8 L 14 17 L 2 17 Z M 4.5 8 L 4.5 5 A 3.5 3.5 0 0 1 11.5 5 L 11.5 8";
                    stroke: #9a9ab0;
                    stroke-width: 1.6px;
                }
            }
        }
        Text {
            x: 64px; y: 660px;
            width: parent.width - 128px;
            text: root.settings-message.starts-with("!") ? root.settings-message.replace-all("!", "") : root.settings-message;
            font-size: 15px;
            color: root.settings-message.starts-with("!") ? #ff9f9f : #8e8ea6;
            overflow: elide;
        }
        Text {
            x: 64px; y: 690px;
            text: "OK to change · Back to go back";
            font-size: 13px; color: #6e6e86;
        }
    }

    if root.picker-show: Rectangle {
        background: #0b0b12a0;
        Rectangle {
            width: 420px; height: 88px + root.picker-items.length * 48px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            border-radius: 16px;
            background: #161826f0;
            Text {
                x: 24px; y: 22px;
                text: root.picker-title;
                font-size: 24px; font-weight: 700;
                color: #f2f2f7;
            }
            for it[i] in root.picker-items: Rectangle {
                x: 16px; y: 72px + i * 48px;
                width: parent.width - 32px; height: 44px;
                border-radius: 10px;
                background: i == root.picker-sel ? #f2f2f7 : transparent;
                Text {
                    x: 16px; height: parent.height;
                    vertical-alignment: center;
                    text: it;
                    font-size: 18px;
                    color: i == root.picker-sel ? #0b0b12 : #c8c8d8;
                }
            }
        }
    }

    // text entry: covers the rows area, the section list stays visible
    if root.te-show: Rectangle {
        x: 360px; y: 120px;
        width: 856px; height: 520px;
        background: #0b0b12;
        Text {
            x: 0; y: 0;
            text: root.te-title;
            font-size: 24px; font-weight: 700;
            color: #f2f2f7;
        }
        Rectangle {
            x: 0; y: 44px; width: 520px; height: 44px;
            border-radius: 10px;
            background: #1a1c2b;
            Text {
                x: 16px; width: parent.width - 32px; height: parent.height;
                vertical-alignment: center;
                text: root.te-value;
                font-size: 22px;
                color: #f2f2f7;
                overflow: elide;
            }
        }
        KeyGrid {
            x: 0; y: 104px;
            keys: root.te-keys;
            focused-key: root.te-focus;
            shift-label: root.te-keys.length > 0 && root.te-keys[0] == "A" ? "abc" : "ABC";
            sym-label: root.te-keys.length > 0 && root.te-keys[0] == "." ? "abc" : "#+=";
        }
    }

    if root.pad-show: Rectangle {
        background: #0b0b12a0;
        Rectangle {
            width: 420px; height: 460px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            border-radius: 16px;
            background: #161826f0;
            Text {
                y: 24px; width: parent.width;
                horizontal-alignment: center;
                text: root.pad-title;
                font-size: 24px; font-weight: 700;
                color: #f2f2f7;
            }
            for i in 8: Rectangle {
                x: (parent.width - 8 * 16px - 7 * 12px) / 2 + i * 28px; y: 76px;
                width: 16px; height: 16px;
                border-radius: 8px;
                background: i < root.pad-len ? #f2f2f7 : transparent;
                border-width: 2px;
                border-color: i < root.pad-len ? #f2f2f7 : #4a4a60;
            }
            Text {
                y: 108px; width: parent.width;
                horizontal-alignment: center;
                text: root.pad-error;
                font-size: 15px;
                color: #ff9f9f;
            }
            for label[i] in root.pad-labels: Rectangle {
                property <bool> focused: i == root.pad-focus;
                x: (parent.width - 3 * 96px - 2 * 12px) / 2 + mod(i, 3) * 108px;
                y: 150px + floor(i / 3) * 68px;
                width: 96px; height: 56px;
                border-radius: 10px;
                background: focused ? #f2f2f7 : #1a1c2b;
                Text {
                    text: label;
                    font-size: 22px;
                    font-weight: focused ? 700 : 400;
                    color: focused ? #0b0b12 : #c8c8d8;
                }
            }
        }
    }

    if root.confirm-show: Rectangle {
        background: #0b0b12a0;
        Rectangle {
            width: 560px; height: 250px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            border-radius: 16px;
            background: #161826f0;
            Text {
                x: 28px; y: 28px;
                text: root.confirm-title;
                font-size: 24px; font-weight: 700;
                color: #f2f2f7;
            }
            Text {
                x: 28px; y: 74px; width: parent.width - 56px;
                text: root.confirm-text;
                font-size: 17px;
                color: #b4b4c8;
                wrap: word-wrap;
            }
            for b[i] in ["Cancel", root.confirm-yes]: Rectangle {
                property <bool> focused: i == root.confirm-focus;
                x: parent.width - 28px - (2 - i) * 162px + 12px; y: parent.height - 28px - 48px;
                width: 150px; height: 48px;
                border-radius: 24px;
                background: focused ? #f2f2f7 : #1a1c2b;
                Text {
                    text: b;
                    font-size: 18px; font-weight: 600;
                    color: focused ? #0b0b12 : #c8c8d8;
                }
            }
        }
    }

    if root.pair-show: Rectangle {
        background: #0b0b12a0;
        Rectangle {
            width: 640px; height: 360px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            border-radius: 16px;
            background: #161826f0;
            Text {
                x: 28px; y: 28px;
                text: "Phone remote";
                font-size: 24px; font-weight: 700;
                color: #f2f2f7;
            }
            Rectangle {
                x: 28px; y: 76px; width: 200px; height: 200px;
                background: white;
                border-radius: 8px;
                Image { x: 8px; y: 8px; width: 184px; height: 184px; source: root.pair-qr; image-rendering: pixelated; visible: root.pair-has-qr; }
            }
            Text {
                x: 252px; y: 76px; width: parent.width - 280px;
                text: "Scan with your phone to pair it:\n" + root.pair-url;
                font-size: 17px;
                color: #b4b4c8;
                wrap: word-wrap;
            }
            Text {
                x: 252px; y: 190px; width: parent.width - 280px;
                text: root.pair-note;
                font-size: 17px;
                color: #f2f2f7;
                wrap: word-wrap;
            }
            for b[i] in ["Back", "Re-pair"]: Rectangle {
                property <bool> focused: i == root.pair-focus;
                x: parent.width - 28px - (2 - i) * 162px + 12px; y: parent.height - 28px - 48px;
                width: 150px; height: 48px;
                border-radius: 24px;
                background: focused ? #f2f2f7 : #1a1c2b;
                Text {
                    text: b;
                    font-size: 18px; font-weight: 600;
                    color: focused ? #0b0b12 : #c8c8d8;
                }
            }
        }
    }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (root.starting) {
                if (event.text == Key.Escape || event.text == Key.Backspace) { root.cancel-start(); }
                return accept;
            }
            if (root.pair-show) {
                if (event.text == Key.LeftArrow) { root.pair-focus = 0; }
                if (event.text == Key.RightArrow) { root.pair-focus = 1; }
                if (event.text == Key.Return || event.text == " ") { root.pair-done(root.pair-focus == 1); }
                if (event.text == Key.Escape || event.text == Key.Backspace) { root.pair-done(false); }
                return accept;
            }
            if (root.confirm-show) {
                if (event.text == Key.LeftArrow) { root.confirm-focus = 0; }
                if (event.text == Key.RightArrow) { root.confirm-focus = 1; }
                if (event.text == Key.Return || event.text == " ") { root.confirm-done(root.confirm-focus == 1); }
                if (event.text == Key.Escape || event.text == Key.Backspace) { root.confirm-done(false); }
                return accept;
            }
            if (root.pad-show) {
                if (event.text == Key.LeftArrow) { if (mod(root.pad-focus, 3) > 0) { root.pad-focus -= 1; } }
                else if (event.text == Key.RightArrow) { if (mod(root.pad-focus, 3) < 2) { root.pad-focus += 1; } }
                else if (event.text == Key.UpArrow) { if (root.pad-focus >= 3) { root.pad-focus -= 3; } }
                else if (event.text == Key.DownArrow) { if (root.pad-focus < 9) { root.pad-focus += 3; } }
                else if (event.text == Key.Return || event.text == " ") {
                    root.pad-key(root.pad-focus == 9 ? "del" : root.pad-focus == 11 ? "ok" : root.pad-labels[root.pad-focus]);
                }
                else if (event.text == Key.Escape) { root.pad-key("cancel"); }
                else if (event.text == Key.Backspace) { root.pad-key("del"); }
                else if (event.text.character-count == 1 && event.text.is-float()) { root.pad-key(event.text); }
                return accept;
            }
            if (root.te-show) {
                if (event.text == Key.RightArrow) { root.te-focus = min(root.te-keys.length - 1, root.te-focus + 1); }
                if (event.text == Key.LeftArrow) { root.te-focus = max(0, root.te-focus - 1); }
                if (event.text == Key.UpArrow) { root.te-focus = max(0, root.te-focus - 10); }
                if (event.text == Key.DownArrow && root.te-focus + 10 < root.te-keys.length) { root.te-focus += 10; }
                if (event.text == Key.Return || event.text == " ") { root.te-key(root.te-keys[root.te-focus]); }
                if (event.text == Key.Escape) { root.te-key("cancel"); }
                if (event.text == Key.Backspace) { root.te-key("delete"); }
                return accept;
            }
            if (root.picker-show) {
                if (event.text == Key.UpArrow) { root.picker-move(-1); }
                if (event.text == Key.DownArrow) { root.picker-move(1); }
                if (event.text == Key.Return || event.text == " ") { root.picker-ok(); }
                if (event.text == Key.Escape || event.text == Key.Backspace) { root.picker-cancel(); }
                return accept;
            }
            if (root.settings-show) {
                if (root.settings-row < 0) {
                    if (event.text == Key.UpArrow && root.settings-section > 0) {
                        root.settings-section -= 1;
                        root.settings-section-changed(root.settings-section);
                    }
                    if (event.text == Key.DownArrow && root.settings-section < root.settings-sections.length - 1) {
                        root.settings-section += 1;
                        root.settings-section-changed(root.settings-section);
                    }
                    if (event.text == Key.RightArrow || event.text == Key.Return || event.text == " ") { root.settings-move(1); }
                    if (event.text == Key.Escape || event.text == Key.Backspace) { root.settings-close(); }
                    return accept;
                }
                if (root.settings-row >= root.settings-rows.length) { root.settings-row = -1; return accept; }
                if (event.text == Key.UpArrow) { root.settings-move(-1); }
                if (event.text == Key.DownArrow) { root.settings-move(1); }
                if (event.text == Key.LeftArrow) {
                    if (root.settings-rows[root.settings-row].kind == "choice" || root.settings-rows[root.settings-row].kind == "toggle") {
                        root.settings-step(root.settings-rows[root.settings-row].key, -1);
                    } else { root.settings-row = -1; }
                }
                if (event.text == Key.RightArrow) {
                    if (root.settings-rows[root.settings-row].kind == "choice" || root.settings-rows[root.settings-row].kind == "toggle") {
                        root.settings-step(root.settings-rows[root.settings-row].key, 1);
                    }
                }
                if (event.text == Key.Return || event.text == " ") {
                    if (root.settings-rows[root.settings-row].kind == "toggle") {
                        root.settings-step(root.settings-rows[root.settings-row].key, 1);
                    } else if (root.settings-rows[root.settings-row].kind != "info") {
                        root.settings-activate(root.settings-rows[root.settings-row].key);
                    }
                }
                if (event.text == Key.Escape || event.text == Key.Backspace) { root.settings-row = -1; }
                return accept;
            }
            if (root.profiles-show) {
                if (event.text == Key.RightArrow) { root.profile-focus = min(root.profiles.length - 1, root.profile-focus + 1); }
                if (event.text == Key.LeftArrow) { root.profile-focus = max(0, root.profile-focus - 1); }
                if (event.text == Key.Return || event.text == " ") { root.profile-pick(root.profile-focus); }
                if (event.text == Key.Escape || event.text == Key.Backspace) { root.profile-close(); }
                return accept;
            }
            if (root.wifi-show) {
                if (event.text == Key.Escape || event.text == Key.Backspace) { root.cancel(); }
                if (root.wifi-pickable && (event.text == Key.Return || event.text == " ")) { root.wifi-pick(); }
                return accept;
            }
            if (root.search-mode && (root.kb-active || root.rows.length == 0)) {
                if (event.text == Key.RightArrow) { root.kb-focus = min(root.kb-keys.length - 1, root.kb-focus + 1); return accept; }
                if (event.text == Key.LeftArrow) { root.kb-focus = max(0, root.kb-focus - 1); return accept; }
                if (event.text == Key.UpArrow) { root.kb-focus = max(0, root.kb-focus - root.kb-cols); return accept; }
                if (event.text == Key.DownArrow) {
                    if (root.kb-focus + root.kb-cols < root.kb-keys.length) { root.kb-focus += root.kb-cols; }
                    else if (root.rows.length > 0) { root.kb-active = false; }
                    return accept;
                }
                if (event.text == Key.Return || event.text == " ") { root.kb-press(root.kb-keys[root.kb-focus]); return accept; }
                if (event.text == Key.Escape) { root.back(); return accept; }
                if (event.text == Key.Backspace) { root.kb-press("delete"); return accept; }
                if (event.text.character-count == 1) { root.kb-press(event.text); return accept; }
                return reject;
            }
            if (root.nav-show && root.nav-focus >= 0) {
                if (event.text == Key.LeftArrow) { root.nav-focus = max(0, root.nav-focus - 1); }
                if (event.text == Key.RightArrow) { root.nav-focus = min(2, root.nav-focus + 1); }
                if (event.text == Key.DownArrow && root.rows.length > 0) { root.nav-focus = -1; }
                if (event.text == Key.Escape || event.text == Key.Backspace) { if (root.rows.length > 0) { root.nav-focus = -1; } else { root.back(); } }
                if (event.text == Key.Return || event.text == " ") {
                    if (root.nav-focus == 0) { root.nav-focus = -1; root.open-search(); }
                    else if (root.nav-focus == 1) { root.open-settings(); }
                    else { root.open-profiles(); }
                }
                return accept;
            }
            if (root.nav-show && event.text == Key.UpArrow && (root.rows.length == 0 || root.cur-row == 0)) {
                root.nav-focus = 0;
                return accept;
            }
            if (root.rows.length == 0) { return reject; }
            if (event.text == Key.UpArrow && root.cur-row == 0) {
                if (root.search-mode) { root.kb-active = true; } else { root.open-search(); }
                return accept;
            }
            if (event.text == Key.RightArrow) { root.moved(root.cur-row, root.rows[root.cur-row].focus + 1); return accept; }
            if (event.text == Key.LeftArrow) { root.moved(root.cur-row, root.rows[root.cur-row].focus - 1); return accept; }
            if (event.text == Key.DownArrow) { root.moved(root.cur-row + 1, -1); return accept; }
            if (event.text == Key.UpArrow) { root.moved(root.cur-row - 1, -1); return accept; }
            if (event.text == Key.Return || event.text == " ") { root.activate(root.cur-row, root.rows[root.cur-row].focus); return accept; }
            if (event.text == Key.Escape || event.text == Key.Backspace) { root.back(); return accept; }
            root.unknown-key(event.text);
            return reject;
        }
    }
}
