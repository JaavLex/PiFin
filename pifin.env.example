# PiFin configuration. Copy to pifin.env and fill it in — pifin.env is gitignored.
#   cp pifin.env.example pifin.env
#   ./build.py --hash-password        # prints the PIFIN_PASS_HASH line below
# build.py reads pifin.env; the older file name secrets.env still works, so existing
# set-ups need no change.

# ---- required -------------------------------------------------------------
# Login password for the PiFin user (console + SSH). Put the hash here, not the
# password: run ./build.py --hash-password and paste the line it prints.
# Or set PIFIN_PASS=my-password instead and build.py hashes it for you.
PIFIN_PASS_HASH=
# Your Jellyfin server, as the TV should reach it (LAN address, .local name,
# or your tailnet address).
JELLYFIN_URL=http://jellyfin.local:8096
# Password for the Wi-Fi setup hotspot (8+ characters; shown as a QR code on the
# TV). Avoid single quotes and leading/trailing spaces in it.
HOTSPOT_PASS=

# ---- optional -------------------------------------------------------------
# Tailscale. Leave empty to skip Tailscale completely; paste a single-use auth
# key (Tailscale admin console -> Access -> keys) to join your tailnet on first
# boot. The key is deleted from the Pi once setup finishes.
TS_AUTHKEY=
# Home Wi-Fi. Leave empty to set Wi-Fi up later through the setup hotspot.
WIFI_SSID=
WIFI_PSK=
# Two-letter country code for the Wi-Fi radio, e.g. DE. Empty = leave the OS default.
WIFI_COUNTRY=
# Timezone, e.g. Etc/UTC (names from /usr/share/zoneinfo).
TIMEZONE=Etc/UTC
# Machine name: mDNS (http://pifin.local) and the Tailscale name.
PIFIN_HOSTNAME=pifin
# Linux user the TV kiosk runs as (created with passwordless sudo, see README).
PIFIN_USER=pifin
# File of OpenSSH public keys to install for SSH, one per line, e.g.
# ~/.ssh/id_ed25519.pub. Empty = SSH with the password only.
SSH_PUBKEY=
# Name of the Wi-Fi setup hotspot.
HOTSPOT_SSID=PiFin-setup
# The UI is rendered this tall and the TV scales it up. Lower = smoother video on
# a Pi 4 (every frame is composited several times); 720 suits most set-ups.
MAX_HEIGHT=720
